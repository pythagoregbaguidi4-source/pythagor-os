# PYTHAGOR OS — splash Plymouth minimal (module script).
# Fond sombre, wordmark cyan centré, fine barre de progression cyan.

Window.SetBackgroundTopColor(0.008, 0.024, 0.020);
Window.SetBackgroundBottomColor(0.008, 0.024, 0.020);

# --- logo (wordmark) ---
logo.image  = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.x = Window.GetX() + Window.GetWidth()  / 2 - logo.image.GetWidth()  / 2;
logo.y = Window.GetY() + Window.GetHeight() / 2 - logo.image.GetHeight() / 2;
logo.sprite.SetX(logo.x);
logo.sprite.SetY(logo.y);

# --- barre de progression ---
bar.image  = Image("bar.png");
bar.width  = 480;
bar.height = 4;
bar.x = Window.GetX() + Window.GetWidth() / 2 - bar.width / 2;
bar.y = logo.y + logo.image.GetHeight() + 60;

fun refresh_cb() {
    if (bar.progress) {
        w = bar.width * bar.progress;
        bar.scaled = bar.image.Scale(w, bar.height);
        bar.sprite = Sprite(bar.scaled);
        bar.sprite.SetX(bar.x);
        bar.sprite.SetY(bar.y);
    }
}
Plymouth.SetRefreshFunction(refresh_cb);

fun progress_cb(duration, progress) {
    bar.progress = progress;
}
Plymouth.SetBootProgressFunction(progress_cb);

# --- invite mot de passe (chiffrement disque le cas échéant) ---
fun display_password_cb(prompt, bullets) {
    Plymouth.SetRefreshFunction(refresh_cb);
}
Plymouth.SetDisplayPasswordFunction(display_password_cb);
