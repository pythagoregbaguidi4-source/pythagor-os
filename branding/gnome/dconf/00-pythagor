# PYTHAGOR OS — défauts GNOME système : identité maison, sombre, accent cyan,
# effet VERRE conservé (blur-my-shell) mais look NON-macOS (Graphite + Papirus).
# Déposé dans /etc/dconf/db/local.d/, compilé par `dconf update`.

[org/gnome/shell]
disable-user-extensions=false
enabled-extensions=['user-theme@gnome-shell-extensions.gcampax.github.com', 'dash-to-dock@micxgx.gmail.com', 'blur-my-shell@aunetx']
favorite-apps=['org.gnome.Nautilus.desktop', 'firefox-esr.desktop', 'org.gnome.Terminal.desktop', 'org.gnome.Software.desktop', 'org.gnome.Settings.desktop']

# Thème SHELL Graphite (accent cyan/teal ; nécessite l'extension user-theme)
[org/gnome/shell/extensions/user-theme]
name='Graphite-teal-Dark'

# Apparence globale : GTK Graphite, icônes Papirus, MODE SOMBRE
[org/gnome/desktop/interface]
gtk-theme='Graphite-teal-Dark'
icon-theme='Papirus-Dark'
cursor-theme='Adwaita'
color-scheme='prefer-dark'
font-name='Cantarell 11'
enable-hot-corners=true
clock-show-weekday=true

[org/gnome/desktop/wm/preferences]
theme='Graphite-teal-Dark'
# Boutons à DROITE (pas la disposition macOS)
button-layout=':minimize,maximize,close'
titlebar-font='Cantarell Bold 11'

# Fond d'écran PYTHAGOR
[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/pythagor.png'
picture-uri-dark='file:///usr/share/backgrounds/pythagor.png'
picture-options='zoom'
primary-color='#05080a'

[org/gnome/desktop/screensaver]
picture-uri='file:///usr/share/backgrounds/pythagor.png'
lock-enabled=false
idle-activation-enabled=false

# Dock en bas, translucide (verre) — dash-to-dock
[org/gnome/shell/extensions/dash-to-dock]
dock-position='BOTTOM'
extend-height=false
dock-fixed=false
intellihide=true
autohide=true
transparency-mode='DYNAMIC'
background-opacity=0.4
customize-alphas=true
min-alpha=0.2
max-alpha=0.6
running-indicator-style='DOTS'
show-apps-at-top=false
dash-max-icon-size=48
click-action='minimize'
show-mounts=false
show-trash=false

# ── EFFET VERRE (blur-my-shell v47) ──────────────────────────────────────────
# Fenêtres, panneaux et menus translucides + floutés. Les COULEURS Graphite ne
# changent pas : on ne touche qu'à la translucidité (opacity) et au flou (sigma).
[org/gnome/shell/extensions/blur-my-shell]
brightness=0.6
sigma=30
color-and-noise=true
hacks-level=1

# Barre du haut + menus système en verre
[org/gnome/shell/extensions/blur-my-shell/panel]
blur=true
brightness=0.6
sigma=30
static-blur=false
unblur-in-overview=false

# Vue d'ensemble (Activités) en verre
[org/gnome/shell/extensions/blur-my-shell/overview]
blur=true
brightness=0.6
sigma=30

# Dock en verre
[org/gnome/shell/extensions/blur-my-shell/dash-to-dock]
blur=true
brightness=0.6
sigma=30
static-blur=true

# FENÊTRES d'applications en verre : légèrement translucides (opacity/255) sur
# fond flouté. La couleur reste Graphite ; la fenêtre ACTIVE redevient plus
# opaque (dynamic-opacity) pour rester lisible.
[org/gnome/shell/extensions/blur-my-shell/applications]
blur=true
opacity=235
dynamic-opacity=true
blur-on-overview=true
enable-all=true

# Session live : ni veille ni verrouillage
[org/gnome/desktop/session]
idle-delay=uint32 0

[org/gnome/settings-daemon/plugins/power]
sleep-inactive-ac-type='nothing'
sleep-inactive-battery-type='nothing'
power-button-action='interactive'
