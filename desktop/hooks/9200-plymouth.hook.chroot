#!/bin/sh
# PYTHAGOR OS — 9200 : splash de démarrage Plymouth.
# Les fichiers du thème sont déjà déposés (includes.chroot) dans
# /usr/share/plymouth/themes/pythagor/.
set -e
echo "[pythagor 9200] splash Plymouth"

if command -v plymouth-set-default-theme >/dev/null 2>&1; then
    plymouth-set-default-theme pythagor
    update-initramfs -u 2>/dev/null || true
fi
