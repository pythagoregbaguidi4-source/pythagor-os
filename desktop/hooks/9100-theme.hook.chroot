#!/bin/sh
# PYTHAGOR OS — 9100 : thème verre PYTHAGOR (Graphite-teal-Dark) + flou.
# NON BLOQUANT (cosmétique). Icônes = Papirus (paquet apt, installé via la liste).
# Graphite via vinceliuice : mêmes correctifs chroot que WhiteSur
# (USER=root sinon getent passwd "" -> exit 2 ; --silent-mode sinon setterm -> exit 1).
set -x
echo "[pythagor 9100] thème Graphite-teal-Dark + blur-my-shell"

WORK=/tmp/pythagor-theme
rm -rf "$WORK"; mkdir -p "$WORK"; cd "$WORK" || exit 0
export HOME=/root
export USER=root
export DEBIAN_FRONTEND=noninteractive
export GIT_TERMINAL_PROMPT=0

# --- blur-my-shell v47 (verre) = dernier compatible GNOME 43 (absent de Debian) ---
BMS=/usr/share/gnome-shell/extensions/blur-my-shell@aunetx
git clone --depth 1 --branch v47 https://github.com/aunetx/blur-my-shell.git bms || echo "[warn] clone blur-my-shell KO"
if [ -d bms ]; then
    mkdir -p "$BMS/schemas"
    cp -a bms/src/. "$BMS/" 2>/dev/null || true
    cp -a bms/metadata.json "$BMS/metadata.json" 2>/dev/null || true
    [ -d bms/resources/ui ] && cp -a bms/resources/ui "$BMS/ui" 2>/dev/null || true
    cp -a bms/schemas/*.gschema.xml "$BMS/schemas/" 2>/dev/null || true
    glib-compile-schemas "$BMS/schemas/" 2>/dev/null || true
fi

# --- Graphite GTK + shell, accent teal (cyan), variante sombre ---
# Graphite n'a PAS --silent-mode (c'est propre à WhiteSur). Sa start_animation
# fait `setterm -cursor off` qui échoue sans tty (chroot) → exit 1. On fournit un
# `setterm` bidon (exit 0) dans le PATH — validé en local (thème produit).
git clone --depth 1 https://github.com/vinceliuice/Graphite-gtk-theme.git graphite || echo "[warn] clone Graphite KO"
if [ -d graphite ]; then
    mkdir -p "$WORK/bin"
    printf '#!/bin/sh\nexit 0\n' > "$WORK/bin/setterm"
    chmod +x "$WORK/bin/setterm"
    ( cd graphite && PATH="$WORK/bin:$PATH" bash ./install.sh --dest /usr/share/themes -t teal -c dark ) > /tmp/graphite.log 2>&1
    rc=$?
    echo "[pythagor 9100] Graphite install -> exit $rc"
    echo "----- 30 dernières lignes -----"; tail -30 /tmp/graphite.log || true; echo "----- fin -----"
fi

cd /
rm -rf "$WORK"

# --- rapport (non bloquant) ---
if [ -d /usr/share/themes/Graphite-teal-Dark ]; then
    echo "[pythagor 9100] OK : Graphite-teal-Dark installé"
    ls -d /usr/share/themes/Graphite-teal* 2>/dev/null || true
else
    echo "[pythagor 9100] ATTENTION : Graphite-teal-Dark absent — GNOME utilisera le thème par défaut (dark+dock+flou restent actifs). Voir la trace."
fi
exit 0
