# Paquets supplémentaires, édition PC uniquement.
# Bureau GNOME habillé façon macOS (verre / WhiteSur). Le thème WhiteSur et
# blur-my-shell sont installés depuis GitHub par le hook 9100 (absents de Debian).

# --- socle GNOME (bookworm = GNOME 43) ---
gnome-core
gdm3
gnome-shell-extensions
gnome-shell-extension-manager
gnome-shell-extension-dashtodock
gnome-tweaks
dconf-cli
dconf-gsettings-backend

# --- serveur X (WaylandEnable=false : session Xorg, robuste en live) ---
xserver-xorg

# --- réseau (gnome-core tire déjà NetworkManager) ---
network-manager-gnome

# --- applications ---
firefox-esr
gnome-terminal
nautilus
gnome-system-monitor
gnome-disk-utility

# --- firmwares (wifi/GPU sur vrai matériel, clé USB live) ---
firmware-linux
firmware-iwlwifi
firmware-realtek
firmware-atheros

# --- amorçage graphique ---
plymouth
plymouth-themes

# --- dépendances de BUILD du thème (purgées par le hook 9900) ---
# libxml2-utils (xmllint) est CRUCIAL : sans lui, l'install WhiteSur déclenche
# son auto-installateur de deps (prepare_deps) qui fait hwclock --systohc en
# chroot et avorte en exit 1. Toutes les deps présentes = prepare_deps jamais
# appelé = thème construit.
sassc
libglib2.0-dev-bin
libxml2-utils

# --- polices ---
fonts-cantarell
fonts-firacode
fonts-noto-color-emoji
fonts-dejavu-core

# --- amorçage live ---
live-boot
live-config
live-config-systemd
