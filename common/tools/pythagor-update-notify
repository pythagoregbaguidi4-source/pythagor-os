#!/bin/bash
# pythagor-update-notify — vérifie les MAJ et affiche une notification GNOME.
# Lancé au login par l'autostart. Silencieux si aucune MAJ.
sleep 25   # laisser la session + le réseau + le démon de notif se mettre en place
if pythagor-update --check 2>/dev/null | grep -qi disponible; then
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -u normal -i software-update-available -a "PYTHAGOR OS" \
            "Mise à jour PYTHAGOR OS disponible" \
            "Ouvre un terminal et lance : pythagor-update"
    fi
fi
